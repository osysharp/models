// Osysharp.Models.Anthropic — the Anthropic Messages API as an `ILlmClient`, written in Osy#.
//
// It needs nothing privileged. It is ordinary Osy# using only public APIs — a class implementing the Llm package's
// `ILlmClient`, building its request with `JsonSerializer` and sending it with `Http.*` — so anyone could have written
// it exactly as it is, for a provider the platform has never heard of.
//
// It asks for one host, and an app that uses it grants it or does not compile. It asks for no SECRET: the API key is a
// setting on the registration, so the app names its own secret (`Client = new AnthropicClient { ApiKey = Secret.Mine }`)
// and this package never learns which.
package Osysharp.Models.Anthropic {
  version "0.1.1";
  minPlatform "0.9.0";
  summary     "the Anthropic Messages API as an app.Models `Client` — complete and stream, with prompt caching.";

  model "model/*.osy";
  use Osysharp.Http;
  use Osysharp.Llm;

  egress "api.anthropic.com";
}
