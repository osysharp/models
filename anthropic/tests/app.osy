// The producer's test project for Osysharp.Models.Anthropic — a ferry line's desk that answers travellers. Nothing is
// sent to Anthropic: `Http.Post.Stub` stands in for it, so a test reads exactly what would have gone out and decides
// what comes back.
app FerryDesk {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Http;
  use Osysharp.Llm@2;
  use Osysharp.Models.Anthropic@1 { egress "api.anthropic.com"; }
}
