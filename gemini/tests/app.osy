// The producer's test project for Osysharp.Models.Gemini — a plant nursery that answers growers. Nothing is sent to
// Google: `Http.Post.Stub` stands in for it, so a test reads exactly what would have gone out and decides what comes
// back.
app PlantNursery {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Http;
  use Osysharp.Llm@2;
  use Osysharp.Models.Gemini@1 { egress "generativelanguage.googleapis.com"; }
}
