// Osysharp.Models.OpenAi — what goes out to OpenAI (or to any endpoint that speaks its wire), and how what comes back is
// read. `Http.Post.Stub` stands in for the API: it keeps each request it was sent, and answers as OpenAI does.
using Osysharp.Llm;
using Osysharp.Http;
using RecipeBox;

[TestFixture]
void Keys() {
  Secret.OpenAi.Stub("sk-test");
  Secret.Annex.Stub("annex-key");
}

/// OpenAI's answer to a plain question.
HttpResponse Says(string text, int promptTokens, int cachedTokens, int completionTokens) {
  return new HttpResponse { StatusCode = 200, Body =
    "{\"choices\":[{\"message\":{\"content\":" + JsonSerializer.Serialize(text) + "},\"finish_reason\":\"stop\"}],"
    + "\"usage\":{\"prompt_tokens\":" + promptTokens + ",\"completion_tokens\":" + completionTokens
    + ",\"prompt_tokens_details\":{\"cached_tokens\":" + cachedTokens + "}}}" };
}

[Test(Keys)]
void a_question_goes_out_in_openais_shape_and_its_answer_and_usage_come_back() {
  Http.Post.Stub((url, body, headers) => {
    new Sent { Url = url, Body = body, Authorization = headers["authorization"] };
    return Says("Twenty minutes.", 3000, 1000, 500);
  });
  Assert.Equal("Twenty minutes.", Answer("How long do lentils take?"));

  var sent = Sent.Single();
  Assert.Equal("https://api.openai.com/v1/chat/completions", sent.Url);
  Assert.Equal("Bearer sk-test", sent.Authorization);
  Assert.Contains("\"model\":\"gpt-4o-mini\"", sent.Body);
  Assert.Contains("How long do lentils take?", sent.Body);
  // The current name for the limit, and nothing that was not asked for.
  Assert.Contains("\"max_completion_tokens\":", sent.Body);
  Assert.DoesNotContain("\"max_tokens\":", sent.Body);
  Assert.DoesNotContain("tool_choice", sent.Body);
  Assert.DoesNotContain("response_format", sent.Body);

  // OpenAI counts the cached prefix inside the prompt; the meter is told them apart:
  // 2000 fresh at $0.15 a million, 1000 cached at $0.075, 500 out at $0.60 — 300 + 75 + 300.
  var row = ModelCall.Single();
  Assert.Equal(2000, row.InputTokens);
  Assert.Equal(1000, row.CacheReadTokens);
  Assert.Equal(500, row.OutputTokens);
  Assert.Equal(675, row.CostMicros);
}

[Test(Keys)]
void an_endpoint_that_speaks_the_same_wire_is_reached_at_its_own_address_with_its_own_key() {
  Http.Post.Stub((url, body, headers) => {
    new Sent { Url = url, Body = body, Authorization = headers["authorization"] };
    return Says("Soak them first.", 100, 0, 10);
  });
  Assert.Equal("Soak them first.", AnswerLocally("And chickpeas?"));
  var sent = Sent.Single();
  Assert.Equal("https://models.annex.example/v1/chat/completions", sent.Url);
  Assert.Equal("Bearer annex-key", sent.Authorization);
  Assert.Contains("\"model\":\"llama-3.3-70b\"", sent.Body);
  // The older name for the limit, which such endpoints still take.
  Assert.Contains("\"max_tokens\":", sent.Body);
  Assert.DoesNotContain("max_completion_tokens", sent.Body);
}

[Test(Keys)]
void a_typed_value_is_asked_for_as_openais_response_format_and_read_from_the_content() {
  Http.Post.Stub((url, body, headers) => {
    new Sent { Body = body };
    return Says("{\"Title\":\"Dal\",\"Serves\":4,\"Minutes\":35,\"Vegetarian\":true}", 800, 0, 40);
  });
  var recipe = ReadRecipe("Dal for four: red lentils, onion, tomato… on the table in 35 minutes.");
  Assert.Equal("Dal", recipe.Title);
  Assert.Equal(4, recipe.Serves);
  Assert.Equal(35, recipe.Minutes);
  Assert.True(recipe.Vegetarian);

  var body = Sent.Single().Body;
  Assert.Contains("\"response_format\":{\"type\":\"json_schema\",\"json_schema\":{\"name\":\"answer\",\"schema\":{", body);
  Assert.Contains("\"strict\":false", body);
  Assert.Contains("Minutes from start to table.", body);
}

[Test(Keys)]
void a_tool_call_comes_back_as_one_and_a_forced_choice_is_sent_in_openais_words() {
  Http.Post.Stub((url, body, headers) => {
    new Sent { Body = body, Seq = Sent.Count() };
    return new HttpResponse { StatusCode = 200, Body =
      "{\"choices\":[{\"message\":{\"content\":null,\"tool_calls\":[{\"id\":\"call_1\",\"function\":{\"name\":\"in_pantry\","
      + "\"arguments\":\"{\\\"ingredient\\\":\\\"cumin\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}],"
      + "\"usage\":{\"prompt_tokens\":200,\"completion_tokens\":20}}" };
  });

  var auto = AskWithPantry("Do I have cumin?", LlmToolChoice.Auto);
  Assert.Equal(LlmStopReason.ToolUse, auto.Response.StopReason);
  var call = auto.Response.Content.Single();
  Assert.Equal(LlmBlockKind.ToolUse, call.Kind);
  Assert.Equal("call_1", call.ToolUseId);
  Assert.Equal("in_pantry", call.ToolName);
  Assert.Equal("{\"ingredient\":\"cumin\"}", call.InputJson);

  AskWithPantry("Do I have cumin?", LlmToolChoice.Any);
  AskWithPantry("Do I have cumin?", LlmToolChoice.None);
  AskWithPantry("Do I have cumin?", LlmToolChoice.Named);
  var bodies = Sent.OrderBy(s => s.Seq).ToList().Select(s => s.Body).ToList();
  Assert.DoesNotContain("tool_choice", bodies[0]);
  Assert.Contains("\"tool_choice\":\"required\"", bodies[1]);
  Assert.Contains("\"tool_choice\":\"none\"", bodies[2]);
  Assert.Contains("\"tool_choice\":{\"type\":\"function\",\"function\":{\"name\":\"in_pantry\"}}", bodies[3]);
}

[Test(Keys)]
void openais_refusal_is_the_providers_failure_and_is_on_the_meter() {
  Http.Post.Stub((url, body, headers) => new HttpResponse { StatusCode = 429, Body = "{\"error\":{\"message\":\"Rate limit reached\"}}" });
  var fault = Assert.Throws<ExternalServiceException>(() => Answer("How long do lentils take?"));
  Assert.Contains("429", fault.Message);
  Assert.Equal(ModelCallOutcome.Failed, ModelCall.Single().Outcome);
}

[Test(Keys)]
void a_pdf_goes_out_as_a_file_part_and_a_photo_as_an_image_url() {
  Http.Post.Stub((url, body, headers) => {
    new Sent { Body = body };
    return Says("{\"Title\":\"Dal\",\"Serves\":4,\"Minutes\":35,\"Vegetarian\":true}", 800, 0, 40);
  });
  Assert.Equal("Dal", ReadRecipeFile("application/pdf", Text.ToBytes("%PDF card")).Title);
  Assert.Equal("Dal", ReadRecipeFile("image/png", Text.ToBytes("png card")).Title);
  var bodies = Sent.ToList().Select(s => s.Body).ToList();
  Assert.True(bodies.Any(b => b.Contains("\"type\":\"file\",\"file\":{\"filename\":\"document.pdf\",\"file_data\":\"data:application/pdf;base64,"
    + Convert.ToBase64String(Text.ToBytes("%PDF card")) + "\"}")));
  Assert.True(bodies.Any(b => b.Contains("\"type\":\"image_url\",\"image_url\":{\"url\":\"data:image/png;base64,")));
}
